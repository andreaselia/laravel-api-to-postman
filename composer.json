{
    "name": "andreaselia/laravel-api-to-postman",
    "description": "Generate a Postman collection automatically from your Laravel API",
    "keywords": [
        "laravel",
        "postman",
        "api",
        "collection",
        "generate"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Elia",
            "email": "andreaselia@live.co.uk"
        }
    ],
    "autoload": {
        "psr-4": {
            "AndreasElia\\PostmanGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndreasElia\\PostmanGenerator\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "illuminate/config": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.7|^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^9.7|^10.0|^11.0|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndreasElia\\PostmanGenerator\\PostmanGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.5.12",
        "laravel/pint": "^1.13"
    }
}
